#!/usr/bin/env bash
# Repo-local envy entry point — runs envy from source without requiring
# a prior `envy apply`. Use this on new machines or during development.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
export ENVY_ROOT="$ROOT"
export PYTHONPATH="$ROOT/resources/scripts:${PYTHONPATH:-}"
# Keep build caches out of the checkout: `path:` flake evaluation hashes every
# file, and bundled sources would capture them in the system closure.
ENVY_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/envy"
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-$ENVY_CACHE_DIR/pycache}"
MIRROR_ENV_SCRIPT="$ROOT/resources/scripts/mirror-env.sh"
FLAKE_SOURCE_MIRROR_SCRIPT="$ROOT/resources/scripts/flake-source-mirror.sh"

# Nix installers update shell startup files, but this process may be running
# before those files have been sourced (notably right after bootstrap). Restore
# the stable profile locations so the repo entry point can discover `nix`.
load_nix_path() {
  local profile_script='/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
  local nix_bin='/nix/var/nix/profiles/default/bin'

  if [ -e "$profile_script" ]; then
    # shellcheck source=/dev/null
    . "$profile_script"
  fi
  if [ -d "$nix_bin" ]; then
    PATH="$nix_bin:${PATH:-}"
  fi
  if [ -d '/nix/profile/bin' ]; then
    PATH="/nix/profile/bin:${PATH:-}"
  fi
  if [ -n "${HOME:-}" ] && [ -d "$HOME/.nix-profile/bin" ]; then
    PATH="$HOME/.nix-profile/bin:${PATH:-}"
  fi
  export PATH
}

if ! command -v nix >/dev/null 2>&1; then
  load_nix_path
fi

# Keep the repo-local entry point reproducible: the host Python may happen to
# provide envy dependencies while still missing the tools and environment from
# this flake's devShell. Re-exec inside `nix develop` once, then let the normal
# source launcher below handle the command.
if [ "${ENVY_DEV_SHELL:-0}" != "1" ] && command -v nix >/dev/null 2>&1; then
  # Point Nix (and language toolchains) at the configured mirror before the
  # devShell closure is fetched, matching setup.sh. Without this the first
  # `nix develop` pulls the whole closure from the upstream cache.
  # shellcheck source=resources/scripts/mirror-env.sh
  [ -f "$MIRROR_ENV_SCRIPT" ] && . "$MIRROR_ENV_SCRIPT"
  if [ -r "$FLAKE_SOURCE_MIRROR_SCRIPT" ]; then
    bash "$FLAKE_SOURCE_MIRROR_SCRIPT" "$ROOT" prime || true
  fi
  export ENVY_DEV_SHELL=1
  exec nix develop "path:$ROOT" --command "$ROOT/envy" "$@"
fi

# The polished frontend is a separate Rust binary. Prefer an installed
# package, while keeping the repository checkout runnable during development.
if [ "${1:-}" = "tui" ] && [ "$#" -eq 1 ] && [ -z "${_ENVY_COMPLETE:-}" ]; then
  shift
  if command -v envy-tui >/dev/null 2>&1; then
    # Keep the TUI's JSON probes and workflows on this checkout's Python CLI
    # instead of whichever unrelated `envy` happens to appear first on PATH.
    export ENVY_BIN="${ENVY_BIN:-$ROOT/envy}"
    exec envy-tui "$@"
  elif command -v cargo >/dev/null 2>&1 && [ -f "$ROOT/resources/scripts/envy-tui/Cargo.toml" ]; then
    exec env ENVY_BIN="$ROOT/envy" \
      CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ENVY_CACHE_DIR/envy-tui-target}" \
      cargo run --quiet --manifest-path "$ROOT/resources/scripts/envy-tui/Cargo.toml" -- "$@"
  else
    echo "error: envy-tui is not installed; enter the Nix devShell or install the envY package." >&2
    exit 1
  fi
fi

# Check Python + required modules
if ! python3 -c "import typer, rich, yaml" 2>/dev/null; then
  echo "error: Python dependencies missing (typer, rich, pyyaml)." >&2
  echo "Enter the Nix devShell or install them with: pip install typer rich pyyaml" >&2
  exit 1
fi

exec python3 -m envy "$@"

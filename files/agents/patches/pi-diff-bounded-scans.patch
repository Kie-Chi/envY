+export const SCAN_LIMITS = {
+  milliseconds: 500,
+  entries: 10_000,
+  fileBytes: 2 * 1024 * 1024,
+  bytes: 8 * 1024 * 1024,
+} as const;
+
+export class ScanLimitError extends Error {
+  constructor() { super("Automatic diff scan budget exceeded"); }
+}
+
+/** Shared bounds for one automatic baseline or comparison, including Git IO. */
+export class ScanBudget {
+  readonly controller = new AbortController();
+  readonly deadline = performance.now() + SCAN_LIMITS.milliseconds;
+  private entries = 0;
+  private bytes = 0;
+
+  get signal(): AbortSignal { return this.controller.signal; }
+
+  check(entries = 0, bytes = 0): void {
+    this.signal.throwIfAborted();
+    this.entries += entries;
+    this.bytes += bytes;
+    if (performance.now() >= this.deadline || this.entries > SCAN_LIMITS.entries || this.bytes > SCAN_LIMITS.bytes) {
+      throw new ScanLimitError();
+    }
+  }
+}
+
+/** Abort outstanding IO and stop scheduling work when a scan loses its budget. */
+export async function withinScanBudget<T>(work: (budget: ScanBudget) => Promise<T>): Promise<T> {
+  const budget = new ScanBudget();
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    return await Promise.race([
+      Promise.resolve().then(() => work(budget)).then((result) => { budget.check(); return result; }),
+      new Promise<never>((_resolve, reject) => {
+        timer = setTimeout(() => {
+          budget.controller.abort();
+          reject(new ScanLimitError());
+        }, SCAN_LIMITS.milliseconds);
+      }),
+    ]);
+  } finally {
+    clearTimeout(timer);
+    budget.controller.abort();
+  }
+}

+import { describe, expect, it, vi } from "vitest";
+import { streamSimple as streamCompletions } from "../src/api/openai-completions.ts";
+import { streamSimple as streamResponses } from "../src/api/openai-responses.ts";
+import { thinkingBudgetForLevel } from "../src/api/simple-options.ts";
+import { clampThinkingLevel, getSupportedThinkingLevels, normalizeContext } from "../src/compat.ts";
+import type { Model } from "../src/types.ts";
+
+const model: Model<"openai-completions"> = {
+	id: "custom-reasoning",
+	name: "Custom Reasoning",
+	api: "openai-completions",
+	provider: "test",
+	baseUrl: "https://offline.invalid/v1",
+	reasoning: true,
+	input: ["text"],
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	contextWindow: 128000,
+	maxTokens: 4096,
+};
+
+describe("ultra thinking level", () => {
+	it("requires explicit model support and falls back to the highest supported level", () => {
+		expect(getSupportedThinkingLevels(model)).not.toContain("ultra");
+		expect(clampThinkingLevel(model, "ultra")).toBe("high");
+		const maxModel = { ...model, thinkingLevelMap: { xhigh: "xhigh", max: "max" } };
+		expect(clampThinkingLevel(maxModel, "ultra")).toBe("max");
+		expect(getSupportedThinkingLevels({ ...maxModel, thinkingLevelMap: { ultra: null } })).not.toContain("ultra");
+		const ultraModel = { ...maxModel, thinkingLevelMap: { ...maxModel.thinkingLevelMap, ultra: "ultra" } };
+		expect(getSupportedThinkingLevels(ultraModel).slice(-3)).toEqual(["xhigh", "max", "ultra"]);
+		expect(clampThinkingLevel(ultraModel, "ultra")).toBe("ultra");
+		expect(thinkingBudgetForLevel("ultra")).toBe(thinkingBudgetForLevel("high"));
+	});
+
+	it.each(["xhigh", "max", "ultra"] as const)("keeps %s distinct in both OpenAI wire APIs", async (reasoning) => {
+		const context = normalizeContext({ messages: [{ role: "user", content: "Hello", timestamp: 0 }] });
+		const enabled = { ...model, thinkingLevelMap: { xhigh: "xhigh", max: "max", ultra: "ultra" } };
+		const fetch = vi.fn<typeof globalThis.fetch>(async () => { throw new Error("network disabled"); });
+		let payload: unknown;
+		const options = {
+			apiKey: "offline-test",
+			reasoning,
+			fetch,
+			onPayload: (request: unknown) => { payload = request; throw new Error("payload captured"); },
+		};
+		await streamCompletions(enabled, context, options).result();
+		expect(payload).toMatchObject({ reasoning_effort: reasoning });
+		payload = undefined;
+		await streamResponses({ ...enabled, api: "openai-responses" }, context, options).result();
+		expect(payload).toMatchObject({ reasoning: { effort: reasoning } });
+		expect(fetch).not.toHaveBeenCalled();
+	});
+});

@@ -0,0 +1,54 @@
+import type { OrchestrationV2GoalTasks } from "@t3tools/contracts";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vite-plus/test";
+import { GoalTaskList } from "./GoalTaskList";
+
+const goal: OrchestrationV2GoalTasks = {
+  version: 1,
+  goalId: "fixture",
+  title: "五阶段计划",
+  status: "running",
+  completed: 1,
+  total: 5,
+  currentTaskId: "verify",
+  currentTaskInferred: false,
+  tasks: [
+    { id: "one", title: "确认需求", status: "complete", depth: 0 },
+    { id: "two", title: "完成实现", status: "pending", depth: 0 },
+    { id: "verify", title: "验证子任务", status: "pending", depth: 1 },
+    { id: "three", title: "检查结果", status: "pending", depth: 0 },
+    { id: "four", title: "整理变更", status: "pending", depth: 0 },
+    { id: "five", title: "交付成果", status: "pending", depth: 0 },
+  ],
+};
+
+describe("GoalTaskList", () => {
+  it("renders every phase and child, including stages after the current one", () => {
+    const html = renderToStaticMarkup(<GoalTaskList goal={goal} />);
+    for (const task of goal.tasks) expect(html).toContain(task.title);
+    expect(html).toContain("Tasks 1/5");
+    expect(html).toContain('aria-label="Complete"');
+    expect(html.match(/aria-current="step"/g)).toHaveLength(1);
+  });
+
+  it("keeps inferred next work distinct from a persisted current task", () => {
+    const html = renderToStaticMarkup(
+      <GoalTaskList goal={{ ...goal, currentTaskInferred: true }} />,
+    );
+    expect(html).toContain("Next");
+    expect(html).not.toContain("aria-current");
+  });
+
+  it("escapes task text and keeps long or deeply nested names available", () => {
+    const title = "<script>alert(1)</script>" + "x".repeat(1000);
+    const html = renderToStaticMarkup(
+      <GoalTaskList
+        goal={{ ...goal, tasks: [{ id: "edge", title, status: "skipped", depth: 64 }] }}
+      />,
+    );
+    expect(html).toContain("&lt;script&gt;");
+    expect(html).not.toContain("<script>");
+    expect(html).toContain("x".repeat(1000));
+    expect(html).toContain('aria-label="Skipped"');
+  });
+});
diff --git a/apps/web/src/components/chat/GoalTaskList.tsx b/apps/web/src/components/chat/GoalTaskList.tsx
new file mode 100644
--- /dev/null
+++ b/apps/web/src/components/chat/GoalTaskList.tsx
@@ -0,0 +1,64 @@
+import type { OrchestrationV2GoalTasks } from "@t3tools/contracts";
+import { CheckIcon, CircleDotIcon, CircleIcon, MinusIcon } from "lucide-react";
+
+export function GoalTaskList({ goal }: { readonly goal: OrchestrationV2GoalTasks }) {
+  const currentIndex = goal.tasks.findIndex((task) => task.id === goal.currentTaskId);
+  const phaseId = goal.tasks.slice(0, currentIndex + 1).findLast((task) => task.depth === 0)?.id;
+  return (
+    <details open className="mt-2 min-w-0 text-sm">
+      <summary className="cursor-pointer list-none text-muted-foreground [&::-webkit-details-marker]:hidden">
+        Tasks {goal.completed}/{goal.total} · {goal.title}
+      </summary>
+      <ol aria-label="Goal tasks" className="mt-2 max-h-64 space-y-1 overflow-y-auto pr-2">
+        {goal.tasks.map((task) => {
+          const current = task.id === goal.currentTaskId || task.id === phaseId;
+          const status =
+            task.status === "complete"
+              ? "Complete"
+              : task.status === "skipped"
+                ? "Skipped"
+                : current
+                  ? goal.currentTaskInferred
+                    ? "Next"
+                    : "Current"
+                  : "Pending";
+          const active = current && !goal.currentTaskInferred;
+          const tone =
+            task.status === "complete"
+              ? "text-emerald-700 dark:text-emerald-400"
+              : task.status === "skipped"
+                ? "text-muted-foreground"
+                : active
+                  ? "text-violet-700 dark:text-violet-300"
+                  : "text-amber-700 dark:text-amber-300";
+          return (
+            <li
+              key={task.id}
+              aria-current={
+                task.id === goal.currentTaskId && !goal.currentTaskInferred ? "step" : undefined
+              }
+              className={`flex gap-2 ${tone}${current ? " font-medium" : ""}`}
+              style={{ paddingInlineStart: Math.min(task.depth, 6) * 16 }}
+            >
+              <span aria-label={status} className="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center">
+                {task.status === "complete" ? (
+                  <CheckIcon className="size-3.5" />
+                ) : task.status === "skipped" ? (
+                  <MinusIcon className="size-3.5" />
+                ) : active ? (
+                  <CircleDotIcon className="size-3.5" />
+                ) : (
+                  <CircleIcon className="size-3.5" />
+                )}
+              </span>
+              <span className="min-w-0 whitespace-pre-wrap wrap-anywhere">
+                {task.title}
+                {current ? ` · ${status}` : ""}
+              </span>
+            </li>
+          );
+        })}
+      </ol>
+    </details>
+  );
+}

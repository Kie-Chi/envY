diff --git a/apps/mobile/src/features/threads/GoalTasksSheet.tsx b/apps/mobile/src/features/threads/GoalTasksSheet.tsx
new file mode 100644
--- /dev/null
+++ b/apps/mobile/src/features/threads/GoalTasksSheet.tsx
@@ -0,0 +1,70 @@
+import type { OrchestrationV2GoalTasks } from "@t3tools/contracts";
+import { ScrollView, View } from "react-native";
+import { AppText as Text } from "../../components/ui/AppText";
+import { Sheet } from "../../components/ui/Sheet";
+
+export function GoalTasksSheet(props: {
+  readonly goal: OrchestrationV2GoalTasks;
+  readonly onClose: () => void;
+}) {
+  const currentIndex = props.goal.tasks.findIndex((task) => task.id === props.goal.currentTaskId);
+  const phaseId = props.goal.tasks
+    .slice(0, currentIndex + 1)
+    .findLast((task) => task.depth === 0)?.id;
+  return (
+    <Sheet title={`Tasks ${props.goal.completed}/${props.goal.total}`} onClose={props.onClose}>
+      <ScrollView contentInsetAdjustmentBehavior="automatic" className="flex-1">
+        <View className="gap-3 px-5 py-4">
+          <Text accessibilityRole="header" className="font-t3-bold text-base text-foreground">
+            {props.goal.title}
+          </Text>
+          {props.goal.tasks.map((task) => {
+            const current = task.id === props.goal.currentTaskId || task.id === phaseId;
+            const status =
+              task.status === "complete"
+                ? "Complete"
+                : task.status === "skipped"
+                  ? "Skipped"
+                  : current
+                    ? props.goal.currentTaskInferred
+                      ? "Next"
+                      : "Current"
+                    : "Pending";
+            const active = current && !props.goal.currentTaskInferred;
+            const tone =
+              task.status === "complete"
+                ? "text-emerald-700 dark:text-emerald-400"
+                : task.status === "skipped"
+                  ? "text-foreground-muted"
+                  : active
+                    ? "text-violet-700 dark:text-violet-300"
+                    : "text-amber-700 dark:text-amber-300";
+            return (
+              <View
+                key={task.id}
+                className="flex-row gap-2"
+                style={{ paddingStart: Math.min(task.depth, 6) * 16 }}
+              >
+                <Text accessibilityLabel={status} className={`w-4 text-center ${tone}`}>
+                  {task.status === "complete"
+                    ? "✓"
+                    : task.status === "skipped"
+                      ? "–"
+                      : active
+                        ? "●"
+                        : "○"}
+                </Text>
+                <Text
+                  className={`flex-1 text-sm ${tone}${current ? " font-t3-bold" : ""}`}
+                >
+                  {task.title}
+                  {current ? ` · ${status}` : ""}
+                </Text>
+              </View>
+            );
+          })}
+        </View>
+      </ScrollView>
+    </Sheet>
+  );
+}
diff --git a/apps/web/src/components/chat/GoalTaskList.test.tsx b/apps/web/src/components/chat/GoalTaskList.test.tsx

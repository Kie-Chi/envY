+import type { EnvironmentId, OrchestrationV2QueueMessages, ProviderThreadId, ThreadId } from "@t3tools/contracts";
+import { isAtomCommandInterrupted, squashAtomCommandFailure } from "@t3tools/client-runtime/state/runtime";
+import { PauseIcon, PlayIcon } from "lucide-react";
+import { useState, type Ref } from "react";
+import { threadEnvironment } from "../../state/threads";
+import { useAtomCommand } from "../../state/use-atom-command";
+import { QueueMessageList, type PiQueueControlHandle } from "./QueueMessageList";
+
+export interface QueueMessageControlOptions {
+  environmentId: EnvironmentId;
+  threadId: ThreadId;
+  providerThreadId: ProviderThreadId;
+  enabled: boolean;
+}
+
+export function QueueMessageControl({ queue, options, ref }: { queue: OrchestrationV2QueueMessages; options: QueueMessageControlOptions; ref?: Ref<PiQueueControlHandle> | undefined }) {
+  const controlQueue = useAtomCommand(threadEnvironment.controlProviderQueue);
+  return <QueueMessageList queue={queue} ref={ref} onControl={options.enabled ? async control => {
+    const result = await controlQueue({ environmentId: options.environmentId, input: { threadId: options.threadId, providerThreadId: options.providerThreadId, control } });
+    if (result._tag === "Failure") {
+      if (isAtomCommandInterrupted(result)) throw new Error("Queue operation interrupted. Check the delivery plan before retrying.");
+      const error = squashAtomCommandFailure(result);
+      throw error instanceof Error ? error : new Error("Could not change the delivery plan.");
+    }
+  } : undefined} />;
+}
+
+export function QueueMessagePauseAction({ queue, options }: { queue: OrchestrationV2QueueMessages; options: QueueMessageControlOptions }) {
+  const controlQueue = useAtomCommand(threadEnvironment.controlProviderQueue);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const paused = queue.paused;
+  const disabled = !options.enabled || queue.plan === undefined || queue.plan.editor !== null || busy;
+  const onClick = async () => {
+    if (disabled || !queue.plan) return;
+    setBusy(true);
+    setError(null);
+    let failure: Error | null = null;
+    try {
+      const result = await controlQueue({
+        environmentId: options.environmentId,
+        input: {
+          threadId: options.threadId,
+          providerThreadId: options.providerThreadId,
+          control: { action: "pause", paused: !paused, revision: queue.plan.revision },
+        },
+      });
+      if (result._tag === "Failure") {
+        if (isAtomCommandInterrupted(result)) {
+          failure = new Error("Queue operation interrupted.");
+        } else {
+          const cause = squashAtomCommandFailure(result);
+          failure = cause instanceof Error ? cause : new Error("Could not change the delivery plan.");
+        }
+      }
+    } catch (cause) {
+      failure = cause instanceof Error ? cause : new Error("Could not change the delivery plan.");
+    }
+    setBusy(false);
+    if (failure) setError(failure.message);
+  };
+  return <button type="button" disabled={disabled} title={error ?? undefined} aria-label={paused ? "Resume queue" : "Pause queue"} onClick={() => void onClick()} className="inline-flex min-h-6 items-center gap-1 rounded px-1.5 text-xs text-muted-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-50">
+    {paused ? <PlayIcon className="size-3" /> : <PauseIcon className="size-3" />}{paused ? "Resume queue" : "Pause queue"}
+  </button>;
+}

+import type { OrchestrationV2QueueMessages, ProviderQueueControl } from "@t3tools/contracts";
+import { ArrowDownIcon, ArrowRightIcon, ArrowUpIcon, Clock3Icon, EllipsisIcon, PauseIcon, PencilIcon, PlayIcon, Trash2Icon } from "lucide-react";
+import { useEffect, useImperativeHandle, useLayoutEffect, useRef, useState, type Ref } from "react";
+import { Menu, MenuItem, MenuPopup, MenuTrigger } from "../ui/menu";
+import { randomUUID } from "~/lib/utils";
+
+export interface PiQueueControlHandle { editLatest: (repeat: boolean) => boolean; }
+type Action = Omit<ProviderQueueControl, "revision">;
+type Editor = { id: string; owner: string; text: string };
+
+export function queuePlanLabel(queue: OrchestrationV2QueueMessages): string {
+  if (!queue.plan) return queue.paused ? "Paused" : "Active";
+  const labels = {
+    paused: queue.plan.errorHold ? "Paused after failed run" : "Paused",
+    "row-paused": "Held at paused message",
+    editing: "Held while editing",
+    control: "Waiting for " + (queue.activity ?? "session control"),
+    "steer-first": "Steering message goes first",
+    ready: "Next: start queued run",
+    "after-run": "Next: after this run",
+  };
+  return labels[queue.plan.state];
+}
+
+export function QueueMessageList({ queue, onControl, ref }: {
+  readonly queue: OrchestrationV2QueueMessages;
+  readonly onControl?: ((control: ProviderQueueControl) => Promise<void>) | undefined;
+  readonly ref?: Ref<PiQueueControlHandle> | undefined;
+}) {
+  const [owner, setOwner] = useState(randomUUID);
+  const [showAll, setShowAll] = useState(false);
+  const [expandedId, setExpandedId] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [draft, setDraft] = useState<Editor | null>(null);
+  const [dismissedEditor, setDismissedEditor] = useState<string | null>(null);
+  const remoteEditor = queue.plan?.editor;
+  const ownsEdit = remoteEditor?.owner === owner;
+  if (ownsEdit && !draft && dismissedEditor !== remoteEditor.id) setDraft(remoteEditor);
+  const canControl = onControl !== undefined && queue.plan !== undefined;
+  const locked = busy || !canControl || remoteEditor != null || draft !== null;
+  const perform = async (action: Action): Promise<boolean> => {
+    if (!onControl || !queue.plan) return false;
+    setBusy(true);
+    setError(null);
+    let succeeded = false;
+    try { await onControl({ ...action, revision: queue.plan.revision }); succeeded = true; }
+    catch (cause) { setError(cause instanceof Error ? cause.message : "Could not change the delivery plan."); }
+    setBusy(false);
+    return succeeded;
+  };
+  const beginEdit = (id: string) => {
+    const editOwner = randomUUID();
+    setOwner(editOwner);
+    setDismissedEditor(null);
+    setDraft(current => current?.id === id ? { ...current, owner: editOwner } : current);
+    void perform({ action: "begin-edit", id, owner: editOwner });
+  };
+  useImperativeHandle(ref, () => ({
+    editLatest: (repeat) => {
+      const last = queue.items.at(-1);
+      if (!canControl || !last) return false;
+      if (locked) return true;
+      if (queue.total > queue.items.length) {
+        setError("The newest message is outside this preview. Choose a visible message from its menu.");
+        return true;
+      }
+      if (!repeat) beginEdit(last.id);
+      return true;
+    },
+  }));
+  const closeEdit = async (save: boolean) => {
+    if (!draft) return false;
+    if (!ownsEdit && !save) { setDismissedEditor(draft.id); setDraft(null); return true; }
+    if (await perform({ action: save ? "save-edit" : "cancel-edit", id: draft.id, owner, ...(save ? { text: draft.text } : {}) })) {
+      setDismissedEditor(draft.id); setDraft(null);
+      return true;
+    }
+    return false;
+  };
+  const rows = showAll ? queue.items : queue.items.slice(0, 3);
+  return (
+    <section aria-label="Pi delivery plan" className="min-w-0 text-sm">
+      <ol aria-label="Queued follow-up messages" className="max-h-48 divide-y divide-border/50 overflow-y-auto overscroll-contain pe-1">
+        {rows.map((item, index) => {
+          const held = item.paused || item.held || (queue.paused && item.dispatchHead);
+          const label = item.paused ? "Held" : item.held ? "Held while editing" : item.dispatchHead ? queue.paused ? "Queue paused" : "Next to send" : "Pending";
+          const detailLabel = item.paused || item.held || (item.dispatchHead && !queue.paused) ? label : null;
+          return <li key={item.id} data-queue-id={item.id} data-queue-head={item.dispatchHead || undefined} className="group/queue-row flex min-w-0 items-start gap-2 py-1">
+            <span aria-label={label} className={"mt-0.5 flex size-4 shrink-0 items-center justify-center " + (held ? "text-amber-600 dark:text-amber-400" : item.dispatchHead ? "text-primary" : "text-muted-foreground/60")}>
+              {held ? <PauseIcon className="size-3.5" /> : item.dispatchHead ? <ArrowRightIcon className="size-3.5" /> : <Clock3Icon className="size-3.5" />}
+            </span>
+            <div className="min-w-0 flex-1">
+              <button type="button" aria-expanded={expandedId === item.id} onClick={() => setExpandedId(expandedId === item.id ? null : item.id)} className="block w-full rounded text-start focus-visible:outline-2 focus-visible:outline-ring">
+                <span className={"whitespace-pre-wrap wrap-anywhere text-[13px] leading-5 " + (expandedId === item.id ? "block" : "line-clamp-2")}>{item.text || (item.imageCount > 0 ? "(Image only message)" : "(No text)")}</span>
+              </button>
+              {detailLabel || item.imageCount > 0 || item.truncated ? <div className="mt-0.5 text-[11px] leading-4 text-muted-foreground wrap-anywhere">
+                {detailLabel ? <span className="me-2">{detailLabel}</span> : null}
+                {item.imageCount > 0 ? <span>{item.imageCount} image {item.imageCount === 1 ? "attachment" : "attachments"}</span> : null}
+                {item.truncated ? <span className="ms-1">Message preview truncated. Open Edit for the full text.</span> : null}
+              </div> : null}
+            </div>
+            {canControl ? <Menu><MenuTrigger disabled={locked} aria-label={"Actions for queued message " + (index + 1)} className="flex size-6 shrink-0 items-center justify-center rounded text-muted-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-40"><EllipsisIcon className="size-4" /></MenuTrigger>
+              <MenuPopup align="end" side="top">
+                <p className="px-2 py-1 font-mono text-[10px] text-muted-foreground">{item.id}</p>
+                <MenuItem onClick={() => beginEdit(item.id)}><PencilIcon />Edit message</MenuItem>
+                <MenuItem onClick={() => void perform({ action: "row-pause", id: item.id, paused: !item.paused })}>{item.paused ? <PlayIcon /> : <PauseIcon />}{item.paused ? "Resume message" : "Hold message"}</MenuItem>
+                <MenuItem disabled={index === 0} onClick={() => void perform({ action: "move", id: item.id, direction: -1 })}><ArrowUpIcon />Move up</MenuItem>
+                <MenuItem disabled={index === queue.total - 1} onClick={() => void perform({ action: "move", id: item.id, direction: 1 })}><ArrowDownIcon />Move down</MenuItem>
+                <MenuItem variant="destructive" onClick={() => void perform({ action: "remove", id: item.id })}><Trash2Icon />Remove message</MenuItem>
+              </MenuPopup>
+            </Menu> : null}
+          </li>;
+        })}
+      </ol>
+      {queue.items.length > 3 ? <button type="button" onClick={() => setShowAll(!showAll)} className="mt-1 rounded text-xs text-muted-foreground hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring">{showAll ? "Show fewer messages" : "Show " + (queue.items.length - 3) + " more messages"}</button> : null}
+      {queue.total > queue.items.length ? <p className="mt-1 text-xs text-muted-foreground">{queue.total - queue.items.length} more queued messages. Use /queue list to view all.</p> : null}
+      {draft ? <QueueEditor key={draft.id} draft={draft} enabled={ownsEdit} busy={busy} onChange={text => setDraft({ ...draft, text })} onClose={closeEdit} onReopen={() => beginEdit(draft.id)} onControl={onControl} revision={queue.plan?.revision ?? ""} /> : remoteEditor ? <p className="mt-2 text-xs text-muted-foreground">A message is being edited in another view.</p> : null}

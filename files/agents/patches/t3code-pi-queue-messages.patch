+import type { OrchestrationV2QueueMessages, OrchestrationV2GoalTasks } from "@t3tools/contracts";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vite-plus/test";
+import { QueueMessageList } from "./QueueMessageList";
+import { extensionStatusBannerItems } from "./ThreadActivityBanners";
+
+const queue: OrchestrationV2QueueMessages = {
+  version: 1,
+  total: 2,
+  paused: true,
+  activity: null,
+  items: [
+    {
+      id: "follow-up-1",
+      text: "先验证\n保留第二行",
+      paused: true,
+      imageCount: 0,
+      truncated: false,
+    },
+    { id: "follow-up-3", text: "Then verify", paused: false, imageCount: 2, truncated: false },
+  ],
+};
+const goal: OrchestrationV2GoalTasks = {
+  version: 1,
+  goalId: "fixture",
+  title: "Goal title",
+  status: "running",
+  completed: 0,
+  total: 1,
+  currentTaskId: null,
+  currentTaskInferred: false,
+  tasks: [{ id: "task", title: "Goal task", status: "pending", depth: 0 }],
+};
+
+describe("QueueMessageList", () => {
+  it("preserves follow-up order, multiline content, held rows and attachment counts", () => {
+    const html = renderToStaticMarkup(<QueueMessageList queue={queue} />);
+    expect(html).toContain("Queued follow-up messages");
+    expect(html).toContain("先验证\n保留第二行");
+    expect(html.indexOf("follow-up-1")).toBeLessThan(html.indexOf("follow-up-3"));
+    expect(html).toContain('aria-label="Held"');
+    expect(html).toContain('aria-label="Pending"');
+    expect(html).toContain("2 image attachments");
+  });
+
+  it("escapes message content and exposes long-message and large-queue limits", () => {
+    const html = renderToStaticMarkup(
+      <QueueMessageList
+        queue={{
+          ...queue,
+          total: 3,
+          items: [{ ...queue.items[0]!, text: "<script>" + "x".repeat(4000), truncated: true }],
+        }}
+      />,
+    );
+    expect(html).not.toContain("<script>");
+    expect(html).toContain("&lt;script&gt;");
+    expect(html).toContain("x".repeat(4000));
+    expect(html).toContain("Message preview truncated");
+    expect(html).toContain("2 more queued messages");
+    expect(html).toContain("wrap-anywhere");
+  });
+
+  it("renders image-only messages without exposing attachment data", () => {
+    const html = renderToStaticMarkup(
+      <QueueMessageList queue={{ ...queue, items: [{ ...queue.items[1]!, text: "" }] }} />,
+    );
+    expect(html).toContain("Image only message");
+    expect(html).toContain("2 image attachments");
+  });
+});
+
+describe("Pi extension banners", () => {
+  it("separates Goal, Queue and other statuses with aligned structured bodies", () => {
+    const items = extensionStatusBannerItems([
+      { key: "queue", text: "Queue mobile preview", queueMessages: queue },
+      { key: "goal", text: "Goal status", goalTasks: goal },
+      { key: "custom", text: "Other status" },
+    ]);
+    expect(items.map((item) => item.id)).toEqual(["pi-goal", "pi-queue", "pi-extension-status"]);
+    expect(renderToStaticMarkup(<>{items[0]!.title}</>)).not.toContain("Queue mobile preview");
+    expect(renderToStaticMarkup(<>{items[1]!.title}</>)).toContain("Delivery plan · 2 follow-ups · Paused");
+    expect(renderToStaticMarkup(<>{items[2]!.title}</>)).toContain("Other status");
+    for (const item of items.slice(0, 2)) {
+      const html = renderToStaticMarkup(<>{item.children}</>);
+      expect(html).toContain("ps-8 sm:ps-7");
+      expect(html).toContain("pe-2 pb-2");
+    }
+  });
+
+  it("supports summary-only extensions and removes emptied queues", () => {
+    const legacy = extensionStatusBannerItems([{ key: "queue", text: "Queue: 1 pending" }]);
+    expect(legacy.map((item) => item.id)).toEqual(["pi-extension-status"]);
+    expect(renderToStaticMarkup(<>{legacy[0]!.title}</>)).toContain("Queue: 1 pending");
+    expect(extensionStatusBannerItems([])).toEqual([]);
+    expect(
+      extensionStatusBannerItems([{ key: "goal", text: "Goal", goalTasks: goal }]).map(
+        (item) => item.id,
+      ),
+    ).toEqual(["pi-goal"]);
+  });
+});

+function QueueEditor({ draft, enabled, busy, onChange, onClose, onReopen, onControl, revision }: {
+  draft: Editor; enabled: boolean; busy: boolean; onChange: (text: string) => void;
+  onClose: (save: boolean) => Promise<boolean>; onReopen: () => void;
+  onControl: ((control: ProviderQueueControl) => Promise<void>) | undefined; revision: string;
+}) {
+  const live = useRef(false);
+  const closing = useRef(false);
+  const control = useRef(onControl);
+  const latestRevision = useRef(revision);
+  useLayoutEffect(() => {
+    control.current = onControl;
+    latestRevision.current = revision;
+  }, [onControl, revision]);
+  // The extension holds the same Pi edit session; renew it while this editor is mounted.
+  useEffect(() => {
+    live.current = true;
+    const send = (action: "renew-edit" | "cancel-edit") => control.current?.({ action, id: draft.id, owner: draft.owner, revision: latestRevision.current }).catch(() => {});
+    const timer = setInterval(() => { if (enabled) void send("renew-edit"); }, 30000);
+    return () => {
+      live.current = false;
+      clearInterval(timer);
+      queueMicrotask(() => { if (!live.current && !closing.current) void send("cancel-edit"); });
+    };
+  }, [draft.id, draft.owner, enabled]);
+  const close = async (save: boolean) => {
+    closing.current = true;
+    if (!await onClose(save)) {
+      closing.current = false;
+      if (!live.current) void control.current?.({ action: "cancel-edit", id: draft.id, owner: draft.owner, revision: latestRevision.current }).catch(() => {});
+    }
+  };
+  return <div className="mt-2 rounded-md border border-border bg-background/70 p-2">
+    <label className="mb-1 block text-xs text-muted-foreground" htmlFor={"queue-edit-" + draft.owner}>{enabled ? "Edit queued follow-up · delivery held" : "Edit expired · your draft is preserved"}</label>
+    <textarea id={"queue-edit-" + draft.owner} aria-label="Edit queued follow-up" autoFocus rows={3} maxLength={65536} value={draft.text} onChange={event => onChange(event.target.value)} onKeyDown={event => {
+      event.stopPropagation();
+      if (event.key === "Escape") { event.preventDefault(); if (!busy) void close(false); }
+      else if (event.key === "Enter" && (event.ctrlKey || event.metaKey)) { event.preventDefault(); if (!busy && enabled) void close(true); }
+    }} className="max-h-48 min-h-20 w-full resize-y rounded border-0 bg-transparent text-[13px] leading-5 outline-none focus-visible:ring-1 focus-visible:ring-ring" />
+    <div className="mt-1 flex items-center justify-between gap-2 text-xs">
+      <span className="text-muted-foreground">Ctrl/⌘ Enter save · Esc cancel</span>
+      <div className="flex gap-2"><button type="button" disabled={busy} onClick={() => void close(false)} className="min-h-7 rounded px-2 hover:bg-muted disabled:opacity-50">Cancel</button>
+        <button type="button" disabled={busy} onClick={() => enabled ? void close(true) : onReopen()} className="min-h-7 rounded bg-primary px-2 text-primary-foreground disabled:opacity-50">{busy ? "Working…" : enabled ? "Save message" : "Reopen edit"}</button></div>
+    </div>
+  </div>;
+}

ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 python3-rich python3-typer python3-yaml gnupg dpkg-dev apt-utils openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONPATH=/workspace/resources/scripts
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/python3", "-B", "resources/scripts/tests/e2e_software_sources.py", "native"]
